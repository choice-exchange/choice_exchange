# Choice mainnet (injective-1) network parameters.
# Sourced by deploy/lib.sh when NETWORK=mainnet.

NODE="https://sentry.tm.injective.network:443"
CHAIN_ID="injective-1"

GAS="3500000"
FEES="1500000000000000inj"

# Keystore key. Must already exist in `injectived keys list`.
FROM="testnet"
PASSWORD="12345678"

# Bech32 of the FROM key. On mainnet the factory `OWNER` should be a
# timelocked multisig and `FEE_COLLECTOR` should be Choice's treasury —
# override both via env vars on the relevant script, not by editing this file.
SIGNER_ADDRESS="inj1q2m26a7jdzjyfdn545vqsude3zwwtfrdap5jgz"

# Choice dev multisig (governance hand-off target — kept here for reference).
CHOICE_DEV_MULTISIG_ADDRESS="inj1vcszz8j58m79exzdlpa8m9u5eyu9r37u7jhm7k"
