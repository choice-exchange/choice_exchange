# Choice testnet (injective-888) network parameters.
# Sourced by deploy/lib.sh when NETWORK=testnet (the default).

NODE="https://testnet.sentry.tm.injective.network:443"
CHAIN_ID="injective-888"

# Gas / fee defaults for store + instantiate. Generous on testnet — adjust per
# script if a particular path needs more (e.g. very large wasms or chained
# instantiates).
GAS="3700000"
FEES="1500000000000000inj"

# Keystore key. Must already exist in `injectived keys list`.
FROM="testnet"
PASSWORD="12345678"

# Bech32 of the FROM key. Used as the default --admin for `wasm instantiate`
# and as the default owner / fee_collector when a deploy script doesn't set
# its own. Override per-script via env vars (OWNER, FEE_COLLECTOR, etc).
SIGNER_ADDRESS="inj1q2m26a7jdzjyfdn545vqsude3zwwtfrdap5jgz"
