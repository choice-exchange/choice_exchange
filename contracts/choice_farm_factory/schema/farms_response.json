{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FarmsResponse",
  "type": "object",
  "required": [
    "farms"
  ],
  "properties": {
    "farms": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/FarmRecord"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "AssetInfo": {
      "description": "AssetInfo contract_addr is usually passed from the cw20 hook so we can trust the contract_addr is properly validated.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "token"
          ],
          "properties": {
            "token": {
              "type": "object",
              "required": [
                "contract_addr"
              ],
              "properties": {
                "contract_addr": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "native_token"
          ],
          "properties": {
            "native_token": {
              "type": "object",
              "required": [
                "denom"
              ],
              "properties": {
                "denom": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "FarmRecord": {
      "type": "object",
      "required": [
        "created_at",
        "created_at_height",
        "farm_addr",
        "farm_owner",
        "id",
        "operator",
        "reward_token",
        "staking_token",
        "total_reward"
      ],
      "properties": {
        "created_at": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "created_at_height": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "farm_addr": {
          "type": "string"
        },
        "farm_owner": {
          "description": "Wasm admin of the spawned farm — the Choice governance timelock at the time of creation. Controls `MsgMigrateContract` against the farm; does NOT have any role on the farm's `Config` state.",
          "type": "string"
        },
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "operator": {
          "description": "User that paid the launch fee, chose the farm's parameters, and is installed as the farm's `Config.owner`. Calls `AddSchedules` / `Fund` / `ProposeNewOwner` etc. directly on the farm contract.",
          "type": "string"
        },
        "reward_token": {
          "$ref": "#/definitions/AssetInfo"
        },
        "staking_token": {
          "$ref": "#/definitions/AssetInfo"
        },
        "total_reward": {
          "$ref": "#/definitions/Uint128"
        }
      },
      "additionalProperties": false
    },
    "Uint128": {
      "description": "A thin wrapper around u128 that is using strings for JSON encoding/decoding, such that the full u128 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances of this and `u128` to get the value out:\n\n``` # use cosmwasm_std::Uint128; let a = Uint128::from(123u128); assert_eq!(a.u128(), 123);\n\nlet b = Uint128::from(42u64); assert_eq!(b.u128(), 42);\n\nlet c = Uint128::from(70u32); assert_eq!(c.u128(), 70); ```",
      "type": "string"
    }
  }
}
