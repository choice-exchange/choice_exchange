      "type": "string"
    },
    "creator_fee_share_bps": {
      "type": "integer",
      "format": "uint16",
      "minimum": 0.0
    },
    "manager": {
      "type": "string"
    },
    "treasury": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
